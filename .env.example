ENV=development
APP_NAME=ajo-backend
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://ajo:ajo@postgres:5432/ajo
REDIS_URL=redis://redis:6379/0
JWT_ISSUER=ajo.local
JWT_AUDIENCE=ajo.api
JWT_ACCESS_SECRET=change-me-local-only-access-secret-32-bytes
REFRESH_TOKEN_PEPPER=change-me-local-only-refresh-pepper-32-bytes
ARGON2_TIME_COST=2
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=2
RAIL_TOPUP=fake
RAIL_COLLECTION=fake
RAIL_PAYOUT=fake

# Stripe sandbox rail. Use sk_test/pk_test/whsec test values only.
# To try Stripe top-ups locally:
#   RAIL_TOPUP=stripe
#   STRIPE_SECRET_KEY=sk_test_...
#   STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_BASE_URL=https://api.stripe.com
STRIPE_CONNECT_ENABLED=false
STRIPE_CONNECT_REFRESH_URL=
STRIPE_CONNECT_RETURN_URL=
SMTP_HOST=mailpit
SMTP_PORT=1025
OTEL_ENABLED=true
OTEL_SERVICE_NAME=ajo-backend
# Set to an OTLP HTTP collector base URL, for example http://otel-collector:4318.
# Leave unset for local development without exporting traces or metrics.
OTEL_EXPORTER_OTLP_ENDPOINT=
